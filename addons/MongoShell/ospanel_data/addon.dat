; WARNING! DO NOT EDIT THIS FILE!

[main]

architecture        = x64
category            = MongoDB Shell
enabled             = on
license             = https://www.apache.org/licenses/LICENSE-2.0
license_type        = Apache License 2.0
min_windows_ver     = 10.0.10240
timestamp           = 1651770000
version             = 2.5.6

[docs]

English             = https://www.mongodb.com/docs/mongodb-shell/

[addon_env.bat]

comment             = ::
destination         = {root_dir}\data\cli\env_{addon_name}.bat
directory_separator = \
enabled             = on
encoding            = UTF8
source_dir          = {root_dir}\system\templates

[environment]

PATH                = {root_dir}\addons\{addon_name};%PATH%
